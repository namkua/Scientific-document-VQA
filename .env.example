# ==========================================
# SCIENTIFIC DOCUMENT VQA - ENVIRONMENT FILE
# ==========================================

# 1. LiteLLM & AI Providers
# API Key provided by Groq for the fallback model (llama-3.2-11b-vision-preview)
GROQ_API_KEY=your_groq_api_key_here
# Address for vLLM running on Vast.ai (Placeholder)
VLLM_API_BASE=http://your_vast_ai_ip_here:8080/v1
# Secure access to vLLM (if you run it with --api-key)
VLLM_API_KEY=your_vllm_api_key_here
# Address for ColQwen2.5 Embedder running on Vast.ai (Placeholder)
EMBEDDER_URL=http://your_vast_ai_embedder_ip_here:8000
# Secure access to Embedder microservice (X-API-Key)
EMBEDDER_API_KEY=your_embedder_api_key_here
# Hugging Face token for downloading models on Vast.ai
HF_TOKEN=your_huggingface_token_here

# 2. Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=vqa_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@postgresql:5432/vqa_db

# 3. Vector Database & Semantic Cache (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 4. Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_password_here
MINIO_URL=localhost:9000
MINIO_BUCKET_NAME=vqa-images
MINIO_PUBLIC_ENDPOINT=your_minio_public_endpoint

# 5. Observability (Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# 6. Observability (Discord Alerting)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
